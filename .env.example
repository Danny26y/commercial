# ==============================================================================
# FASTAPI MULTI-PROVIDER AI ROUTER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Security: Comma-separated list of authorized API keys for client access
# Clients must pass one of these keys in the 'X-API-Key' header.
API_KEYS=sk-router-admin-test-key-1,sk-router-client-test-key-2

# CORS: Comma-separated list of allowed origins or '*' for all
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# LLM Provider Credentials & Base URLs
# ------------------------------------------------------------------------------
# Leave API keys empty if you do not plan to use that specific provider.
# The router dynamically skips any unconfigured providers.

# 1. OpenAI (Primary default)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# 2. Anthropic (Claude 3.5 Sonnet / Haiku)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# 3. Groq (Ultra-low latency Llama 3 models)
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 4. OpenRouter (Universal gateway fallback)
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# Resilient Router Strategy & Circuit Breaker Settings
# ------------------------------------------------------------------------------
# Primary default provider
DEFAULT_PROVIDER=openai

# Ordered fallback chain. If the first fails (429, 5xx, timeout), the router
# immediately cascades down this list until a healthy provider responds.
PROVIDER_FALLBACK_ORDER=openai,groq,anthropic,openrouter

# HTTP Request Timeout per LLM call (in seconds)
REQUEST_TIMEOUT_SECONDS=30.0

# Number of immediate retries on the same provider before failing over
MAX_RETRIES_PER_PROVIDER=1

# Circuit Breaker: consecutive failures before tripping provider to OPEN state
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3

# Circuit Breaker: time in seconds to wait before probing tripped provider
CIRCUIT_BREAKER_RECOVERY_TIME_SECONDS=60.0
